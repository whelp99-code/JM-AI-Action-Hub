# JM-AI Action Hub Server v0.9.0
# Start in dry_run. Switch to live only after reviewing connector payloads.

# Core
ACTION_HUB_APP_ENV=development
# Set ACTION_HUB_HOST=0.0.0.0 only for an intentional LAN bind, with a secure
# API key and network controls (firewall, VPN, or reverse proxy) in place.
ACTION_HUB_HOST=127.0.0.1
ACTION_HUB_PORT=8787
ACTION_HUB_LOG_LEVEL=INFO
ACTION_HUB_TIMEZONE=Asia/Seoul
ACTION_HUB_API_KEY=change-me-before-exposing-to-network
ACTION_HUB_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
ACTION_HUB_DATABASE_URL=sqlite+pysqlite:///./data/action_hub.db
ACTION_HUB_DATA_DIR=./data
ACTION_HUB_RUN_MIGRATIONS=true
ACTION_HUB_EXECUTION_MODE=dry_run

# Durable control loop
# Docker Compose runs a separate worker and overrides WORKER_INLINE=false.
ACTION_HUB_WORKER_INLINE=true
ACTION_HUB_WORKER_POLL_SECONDS=2
ACTION_HUB_OUTBOX_BATCH_SIZE=50
ACTION_HUB_OUTBOX_MAX_ATTEMPTS=5
ACTION_HUB_RETRY_BASE_SECONDS=5
ACTION_HUB_WEBHOOK_BATCH_SIZE=100
ACTION_HUB_RECONCILIATION_BATCH_SIZE=100
ACTION_HUB_RECONCILIATION_INTERVAL_SECONDS=300
ACTION_HUB_PROCESSING_LOCK_TIMEOUT_SECONDS=300

# Planning / follow-up / learning
ACTION_HUB_DEFAULT_ESTIMATED_MINUTES=30
ACTION_HUB_DEFAULT_WORKDAY_MINUTES=480
ACTION_HUB_PLANNING_BUFFER_PERCENT=15
ACTION_HUB_FOLLOWUP_DEFAULT_DAYS=2
ACTION_HUB_PERSONAL_RULE_MIN_OBSERVATIONS=3
ACTION_HUB_IMPORTANCE_THRESHOLD=60
ACTION_HUB_URGENCY_THRESHOLD=60
ACTION_HUB_BIG3_LIMIT=3
ACTION_HUB_FOCUS_DEFAULT_MINUTES=25
ACTION_HUB_FOCUS_WARNING_PERCENT=80
ACTION_HUB_FOCUS_MAX_MINUTES=240
ACTION_HUB_FOCUS_WEEKLY_WINDOW_DAYS=7

# Native iOS companion. Set an independent secret before production use.
# Development may derive a domain-separated signing key from a secure API key
# only when this value is empty; changing either secret invalidates mobile tokens.
ACTION_HUB_MOBILE_ENABLED=true
ACTION_HUB_MOBILE_PUBLIC_BASE_URL=
ACTION_HUB_MOBILE_ACCESS_TOKEN_SECRET=change-me-mobile-token-secret-before-use
ACTION_HUB_MOBILE_ACCESS_TOKEN_MINUTES=15
ACTION_HUB_MOBILE_REFRESH_TOKEN_DAYS=30
# Lost-response retry window. Reuse after this window revokes the token family.
ACTION_HUB_MOBILE_REFRESH_REUSE_GRACE_SECONDS=30
ACTION_HUB_MOBILE_PAIRING_TTL_SECONDS=300
ACTION_HUB_MOBILE_PAIRING_MAX_ATTEMPTS=5
ACTION_HUB_MOBILE_CAPTURE_BATCH_SIZE=50
ACTION_HUB_MOBILE_CHANGE_BATCH_SIZE=200
ACTION_HUB_MOBILE_MIN_IOS_APP_VERSION=0.1.0
ACTION_HUB_MOBILE_RECOMMENDED_IOS_APP_VERSION=0.2.1

# Apple Push Notification service. Keep the .p8 key outside the repository.
ACTION_HUB_APNS_TEAM_ID=
ACTION_HUB_APNS_KEY_ID=
ACTION_HUB_APNS_BUNDLE_ID=com.jmactionhub.ios
ACTION_HUB_APNS_PRIVATE_KEY_PATH=
ACTION_HUB_APNS_ENVIRONMENT=sandbox
ACTION_HUB_APNS_BATCH_SIZE=100
ACTION_HUB_APNS_MAX_ATTEMPTS=5

# Parser: rules | hybrid | llm
ACTION_HUB_PARSER_MODE=rules
ACTION_HUB_LLM_BASE_URL=
ACTION_HUB_LLM_API_KEY=
ACTION_HUB_LLM_MODEL=
ACTION_HUB_LLM_TIMEOUT_SECONDS=45
ACTION_HUB_REQUEST_TIMEOUT_SECONDS=20
ACTION_HUB_MAX_INPUT_CHARS=30000
ACTION_HUB_MAX_REQUEST_BODY_BYTES=1048576
ACTION_HUB_DEFAULT_EVENT_MINUTES=60

# Todoist personal access token + webhook app client secret
ACTION_HUB_TODOIST_TOKEN=
ACTION_HUB_TODOIST_DEFAULT_PROJECT_ID=
ACTION_HUB_TODOIST_CLIENT_SECRET=

# GitHub fine-grained token. Grant only selected repositories and required
# Issues/Actions permissions. Webhook secret is independent from the API token.
ACTION_HUB_GITHUB_TOKEN=
ACTION_HUB_GITHUB_DEFAULT_REPO=
ACTION_HUB_GITHUB_WEBHOOK_SECRET=
ACTION_HUB_ALLOW_UNSIGNED_WEBHOOKS=false
ACTION_HUB_PROJECT_ROUTES_JSON={}

# Existing AI-worker GitHub workflows. Action Hub dispatches them; it does not
# reimplement Codex, Claude Code, Copilot, Orca, Hermes, or Master Worker.
# Example:
# {"codex":{"repository":"owner/repo","workflow":"codex.yml","ref":"main"}}
ACTION_HUB_WORKER_ROUTES_JSON={}

# Google Calendar. For a quick local test a short-lived access token is enough.
# For continuous operation configure the refresh-token fields instead.
ACTION_HUB_GOOGLE_CALENDAR_ACCESS_TOKEN=
ACTION_HUB_GOOGLE_CALENDAR_ID=primary
ACTION_HUB_GOOGLE_OAUTH_CLIENT_ID=
ACTION_HUB_GOOGLE_OAUTH_CLIENT_SECRET=
ACTION_HUB_GOOGLE_OAUTH_REFRESH_TOKEN=
ACTION_HUB_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# Fireflies V2 webhook + GraphQL transcript retrieval
ACTION_HUB_FIREFLIES_API_KEY=
ACTION_HUB_FIREFLIES_WEBHOOK_SECRET=
ACTION_HUB_FIREFLIES_GRAPHQL_URL=https://api.fireflies.ai/graphql

# Optional PostgreSQL Docker Compose overlay
POSTGRES_PASSWORD=change-this-postgres-password
